// Copy to Secrets.xcconfig (git-ignored) and fill in. See docs/GOOGLE-SETUP.md.
// Release builds (bundle id APP_BUNDLE_ID).
GOOGLE_CLIENT_ID = temp
GOOGLE_REVERSED_CLIENT_ID = temp
// Debug builds (bundle id APP_BUNDLE_ID.dev) need their own iOS client; leave out to keep
// sync off in Debug.
GOOGLE_CLIENT_ID_DEV = temp
GOOGLE_REVERSED_CLIENT_ID_DEV = temp
